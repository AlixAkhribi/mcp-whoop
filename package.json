{
	"name": "mcp-whoop",
	"version": "0.7.0",
	"description": "Model Context Protocol (MCP) server for WHOOP, served over stdio",
	"keywords": [
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"whoop",
		"stdio"
	],
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": "^22.22.1 || >=24.10.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlixAkhribi/mcp-whoop.git"
	},
	"bin": {
		"mcp-whoop": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"prepare": "node scripts/prepare.mjs",
		"prepack": "npm run build",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"fix": "biome check --write .",
		"test": "vitest run --exclude \"tests/package/**\"",
		"test:package": "vitest run tests/package",
		"inspect": "pnpm dlx @modelcontextprotocol/inspector@2.2.0 --web tsx src/index.ts",
		"inspect:cli": "pnpm dlx @modelcontextprotocol/inspector@2.2.0 --cli tsx src/index.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@modelcontextprotocol/client": "^2.0.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/node": "^22.20.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"semantic-release": "^25.0.9",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.11",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
