# WHOOP application credentials. Register your own application in the WHOOP
# Developer Dashboard (https://developer-dashboard.whoop.com) and copy these
# from its settings. `mcp-whoop login` requires all three; a serving process
# requires none of them — the stored login carries everything a refresh needs —
# but does read them where they are set, to override the stored pair and to
# offer a WHOOP login inside a conversation.
#
# Copy this file to `.env` (git-ignored) and load it natively with
# `node --env-file=.env dist/index.js login` — no dotenv involved.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# The address WHOOP sends the browser back to, as registered in the dashboard.
# Read by `mcp-whoop login` and by serving, which catches that redirect on a
# loopback port of this machine when it offers a login inside a conversation. A
# value that is not a URL costs that offer and warns on stderr; it never stops
# the server, so a typo here cannot take every tool down.
WHOOP_REDIRECT_URI=http://127.0.0.1:8788/callback

# Ask for less than every read scope at login, comma- or space-separated.
#WHOOP_SCOPES=read:profile,read:sleep

# Keep the token file in this directory instead of the platform's per-user
# data area.
#WHOOP_TOKEN_STORE=

# How much the server says on stderr: debug, info (the default), warning, or
# error. Diagnostics never touch stdout — under `stdio` that is the wire.
#WHOOP_LOG_LEVEL=info

# The login serving offers inside a conversation: how long a tool call waits
# for WHOOP to send the browser back before asking the client to come round
# again, and how long an offer nobody answers keeps the loopback port it
# borrowed to catch that redirect.
#WHOOP_LOGIN_WAIT_MS=2000
#WHOOP_LOGIN_TTL_MS=600000

# For tests and local development only.
#WHOOP_HTTP_TIMEOUT_MS=30000
#WHOOP_API_BASE_URL=https://api.prod.whoop.com
